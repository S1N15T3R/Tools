# =======================================================
# BountyTargetScout - Configuration File (.env)
# =======================================================

# -------------------------------------------------------
# LLM Provider Configuration (OpenAI-compatible)
# -------------------------------------------------------
# For Omniroute: http://localhost:20128/v1
# For OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=MY-gemini-3.8-flash

# -------------------------------------------------------
# Report & Target Settings
# -------------------------------------------------------
# Formats: markdown, html, both
DEFAULT_FORMAT=both
DEFAULT_COUNT=2

# -------------------------------------------------------
# Optional: Bug Bounty Platform Authenticated Mode
# (Unlocks private invitations and deeper scope details)
# Note: Anti-ban circuit breaker & rate limits are active.
# -------------------------------------------------------

# HackerOne Official Hacker API (https://hackerone.com/settings/api_token)
# H1_API_IDENTIFIER=your_hackerone_username
# H1_API_TOKEN=your_hackerone_api_token

# YesWeHack Bearer JWT Token (from browser DevTools / LocalStorage)
# YWH_API_TOKEN=your_yeswehack_jwt_token

# Bugcrowd Session Cookie (Value of '_crowdcontrol_session' cookie)
# BUGCROWD_SESSION_TOKEN=your_crowdcontrol_session_value
